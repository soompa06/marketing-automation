# Aoostar 통합 스택 환경변수 — `.env`로 복사 후 채울 것
# ⚠️ 이 파일은 절대 git에 올리지 말 것. (.gitignore에 등록)

# ============================================================
# Cloudflare Tunnel
# ============================================================
# Cloudflare Zero Trust 대시보드 → Tunnels → Create tunnel → Docker → 토큰 복사
CLOUDFLARE_TUNNEL_TOKEN=eyJh...

# ============================================================
# 저장 경로 (호스트에 미리 만들어두고 권한 조정)
#   sudo mkdir -p /srv/{immich/upload,immich/postgres,nextcloud/data,nextcloud/db}
#   sudo chown -R 1000:1000 /srv/immich
#   sudo chown -R 33:33    /srv/nextcloud/data   # www-data
# ============================================================
IMMICH_UPLOAD_DIR=/srv/immich/upload
IMMICH_DB_DIR=/srv/immich/postgres
NEXTCLOUD_DATA_DIR=/srv/nextcloud/data
NEXTCLOUD_DB_DIR=/srv/nextcloud/db

# ============================================================
# Immich
#   ※ DB 비밀번호는 처음 한 번만 설정. 바꾸면 DB 재생성 필요.
# ============================================================
IMMICH_VERSION=release

# Immich 서버가 DB에 접속할 때 쓰는 값
DB_HOSTNAME=immich_postgres
DB_USERNAME=postgres
DB_PASSWORD=change_me_immich_db
DB_DATABASE_NAME=immich

# Postgres 컨테이너 초기화용 (위와 일치)
POSTGRES_PASSWORD=change_me_immich_db
POSTGRES_USER=postgres
POSTGRES_DB=immich

REDIS_HOSTNAME=immich_redis

# 업로드 폴더 위치 (컨테이너 안에서)
UPLOAD_LOCATION=/usr/src/app/upload

# ============================================================
# Nextcloud
# ============================================================
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change_me_nextcloud_admin
NEXTCLOUD_TRUSTED_DOMAINS=localhost 127.0.0.1 100.64.0.0/10   # Tailscale 대역 허용

# Nextcloud용 DB
MYSQL_HOST=nextcloud_db
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=change_me_nextcloud_db
MYSQL_ROOT_PASSWORD=change_me_nextcloud_root

# 시간대
TZ=Asia/Seoul
