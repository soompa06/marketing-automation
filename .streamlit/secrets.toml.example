# =============================================================================
# Streamlit Cloud Secrets 예시 — 실제 값은 streamlit.io 대시보드의
# App settings → Secrets 에 붙여넣으세요. (이 파일 자체는 예시일 뿐,
# 실제 secrets.toml은 .gitignore로 커밋되지 않습니다.)
# =============================================================================

# (선택) 공용 비밀번호 — 링크를 아는 사람 중 비번을 아는 사람만 접속 가능.
# 비워두거나 줄을 지우면 비밀번호 없이 누구나 접속.
app_password = "원하는비밀번호"

# config/settings.json 전체 내용을 그대로 문자열로 넣습니다.
# (앱의 load_settings()가 파일이 없으면 이 값을 JSON으로 파싱합니다.)
settings_json = '''
{
  "campaigns": {
    "restaurant": { "default_keywords": ["둔산동 회식", "대전 가성비 맛집"] },
    "skin":       { "default_keywords": ["강남 리투오", "신논현역 성형외과"] }
  },
  "blogdex": {
    "query_delay_seconds": 2,
    "rate_limit_wait_seconds": 60,
    "max_rate_limit_retries": 5
  }
}
'''
